---
import { socials } from '../lib/site';

/*
  Official club accounts. Brand glyphs are drawn inline rather than pulled from
  an icon font — nothing external loads, and they take their colour from the
  surface they sit on.
*/
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const GLYPH: Record<string, string> = {
  facebook:
    'M14 8.5h2.2V5.6A29 29 0 0 0 13.9 5.5c-2.3 0-3.9 1.4-3.9 4v2.3H7.3v3.2H10V23h3.2v-8h2.7l.4-3.2h-3.1V9.8c0-.9.3-1.3 1.3-1.3Z',
  instagram:
    'M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2Zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5.8-7.8a1.07 1.07 0 1 1-2.15 0 1.07 1.07 0 0 1 2.15 0ZM21 8.8c-.07-1.44-.4-2.72-1.45-3.77S17.22 3.65 15.78 3.58c-1.48-.08-5.92-.08-7.4 0-1.44.06-2.71.39-3.77 1.44S3.24 7.35 3.17 8.79c-.08 1.48-.08 5.92 0 7.4.07 1.44.4 2.72 1.44 3.77s2.33 1.38 3.77 1.45c1.48.08 5.92.08 7.4 0 1.44-.07 2.72-.4 3.77-1.45s1.38-2.33 1.45-3.77c.08-1.48.08-5.91 0-7.39Zm-1.9 8.98a3.04 3.04 0 0 1-1.71 1.71c-1.19.47-4 .36-5.31.36s-4.13.1-5.31-.36a3.04 3.04 0 0 1-1.71-1.71c-.47-1.19-.36-4-.36-5.31s-.1-4.13.36-5.31a3.04 3.04 0 0 1 1.71-1.71c1.19-.47 4-.36 5.31-.36s4.13-.1 5.31.36a3.04 3.04 0 0 1 1.71 1.71c.47 1.19.36 4 .36 5.31s.11 4.13-.36 5.31Z',
  playhq:
    'M12 2.5 21 7v10l-9 4.5L3 17V7l9-4.5Zm0 2.2L5 8v8l7 3.5 7-3.5V8l-7-3.3Zm-1.6 4 5 3.3-5 3.3V8.7Z',
};
---

{
  socials.length > 0 && (
    <ul class:list={['flex items-center gap-4', className]}>
      {socials.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer external me"
            class="inline-flex items-center transition-opacity hover:opacity-70"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
              <path d={GLYPH[s.key]} />
            </svg>
            <span class="sr-only">{s.label} (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
