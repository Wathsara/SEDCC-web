---
import { Image } from 'astro:assets';
import CricketIcon from './CricketIcon.astro';
import type { Sponsor } from '../lib/site';

interface Props {
  sponsor: Sponsor;
}
const { sponsor } = Astro.props;

const tel = sponsor.phone ? sponsor.phone.replace(/[^\d+]/g, '') : null;

const details = [
  sponsor.address && { label: 'Address', value: sponsor.address, href: null },
  sponsor.email && { label: 'Email', value: sponsor.email, href: `mailto:${sponsor.email}` },
  sponsor.phone && tel && {
    label: sponsor.phoneLabel ?? 'Phone',
    value: sponsor.phone,
    href: `tel:${tel}`,
  },
].filter(Boolean) as Array<{ label: string; value: string; href: string | null }>;
---

<!--
  The featured sponsor gets the top of the page and the full width. The
  emphasis is the layout — nothing here labels them, and the page reads as
  though this is simply where their entry sits.
-->
<article class="tile overflow-hidden" data-rule-in>
  <div class="grid items-center lg:grid-cols-[1fr_1.5fr]">
    <div class="relative border-b border-rule bg-club lg:border-b-0 lg:border-r">
      {
        sponsor.image && (
          <Image
            src={sponsor.image}
            alt={`${sponsor.name} logo`}
            widths={[400, 800]}
            sizes="(min-width: 1024px) 420px, 100vw"
            class="h-full max-h-72 w-full object-contain lg:max-h-none"
          />
        )
      }
    </div>

    <div class="p-7 sm:p-8">
      {
        sponsor.strapline && (
          <p class="font-figures text-2xs uppercase tracking-eyebrow text-accent">
            {sponsor.strapline}
          </p>
        )
      }
      <h2 class="mt-2 font-display text-xl uppercase leading-tight text-club sm:text-2xl">
        {sponsor.headline ?? sponsor.name}
      </h2>
      {sponsor.blurb && <p class="mt-3 leading-relaxed text-ink-muted">{sponsor.blurb}</p>}
      {
        (sponsor.body ?? []).map((para) => (
          <p class="mt-4 leading-relaxed text-ink-muted">{para}</p>
        ))
      }

      {
        details.length > 0 && (
          <dl class="mt-6 grid gap-4 border-t border-rule pt-5 sm:grid-cols-3">
            {details.map((d) => (
              <div>
                <dt class="eyebrow">{d.label}</dt>
                <dd class="mt-1 break-words text-sm">
                  {d.href ? (
                    <a href={d.href} class="stitch-link text-club">
                      {d.value}
                    </a>
                  ) : (
                    <span class="text-ink-muted">{d.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        sponsor.url && (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer external"
            class="mt-6 inline-flex items-center gap-2 bg-club px-6 py-3 font-display text-sm uppercase tracking-eyebrow text-paper transition-colors hover:bg-club-tint"
          >
            <CricketIcon name="boundary" class="h-4 w-4" />
            Visit {sponsor.name}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )
      }
    </div>
  </div>
</article>
