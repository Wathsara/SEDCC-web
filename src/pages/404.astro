---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Page not found">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-display text-4xl uppercase text-club">Played on</h1>
    <p class="mx-auto mt-4 max-w-prose text-ink-muted">
      That page isn’t here. It may have moved, or the season it belonged to has finished.
    </p>
    <a
      href={url('/')}
      class="mt-8 inline-block bg-club px-6 py-3 font-display text-sm uppercase tracking-eyebrow text-paper hover:bg-club-tint"
      >Back to the club</a
    >
  </div>
</Base>
