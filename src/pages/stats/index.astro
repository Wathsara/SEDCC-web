---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import EmptyState from '../../components/EmptyState.astro';
import WeeklyBest from '../../components/WeeklyBest.astro';
import LeaderTable from '../../components/LeaderTable.astro';
import { season, url } from '../../lib/site';
import { hasWeeklyStats, hasSeasonStats, weekly, seasonStats } from '../../lib/playhq';

---

<Base title="Stats" description="Weekly top batter and bowler, plus season leaderboards for Dreamers CC.">
  <PageHeader
    eyebrow={season.label}
    title="Stats"
    intro="Top batter and top bowler across all three sides every week, and the season leaderboards behind them."
  />

  <div class="mx-auto max-w-6xl px-4 py-16 space-y-16">
    <section>
      <SectionHead title="This week's best" note={season.label} />
      <div class="mt-6">
        {
          hasWeeklyStats ? (
            <WeeklyBest batter={weekly.topBatter} bowler={weekly.topBowler} />
          ) : (
            <EmptyState title="No performances yet" />
          )
        }
      </div>
    </section>

    <section>
      <SectionHead title="Season leaderboards" note={season.label} />
      <div class="mt-6">
        {
          hasSeasonStats ? (
            <LeaderTable players={seasonStats.players} />
          ) : (
            <EmptyState title="No leaderboards yet" />
          )
        }
      </div>
    </section>

    <section class="tile p-8 bg-club text-paper border border-[#dfb74c]/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="eyebrow text-[#dfb74c]">All-Time Heritage</p>
        <h3 class="mt-2 font-display text-2xl uppercase tracking-wide text-paper">Club Honours Board</h3>
        <p class="mt-1 text-sm text-accent-tint">All centuries, 5-wicket hauls, and individual club records since 2024.</p>
      </div>
      <a href={url('honour-board')} class="stitch-link font-display text-sm uppercase tracking-eyebrow text-[#dfb74c] shrink-0 hover:text-paper transition-colors">
        View Honours Board →
      </a>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/motion.ts';
</script>
