---
import ResultChip from './ResultChip.astro';
import { formatDate, isoDate } from '../lib/format';
import type { PastGame } from '../lib/seasons';

interface Props {
  game: PastGame;
}
const { game } = Astro.props;

const CHIP: Record<string, { letter: 'W' | 'L' | 'D' | 'T' | 'N'; label: string }> = {
  WON: { letter: 'W', label: 'Won' },
  LOST: { letter: 'L', label: 'Lost' },
  DRAWN: { letter: 'D', label: 'Drawn' },
  TIED: { letter: 'T', label: 'Tied' },
  ABANDONED: { letter: 'N', label: 'Abandoned' },
  FORFEIT: { letter: 'N', label: 'Forfeit' },
};
CHIP.BYE = { letter: 'N', label: 'Bye' };
const chip = CHIP[game.outcome] ?? CHIP.ABANDONED;

const bye = game.outcome === 'BYE';
const abandoned = game.outcome === 'ABANDONED';
const summary = bye
  ? 'No game this round'
  : abandoned
    ? 'Abandoned — no result'
    : `${game.outcome === 'WON' ? 'Won' : 'Lost'} by ${game.margin}`;

/* Who batted first is inferred from the margin: a win "by runs" was defended,
   a win "by wickets" was chased. Null where the margin does not say. */
const order =
  game.battedFirst === null ? null : game.battedFirst ? 'Batted first' : 'Chased';
---

<div class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-4 gap-y-2 border-b border-rule py-5 sm:grid-cols-[auto_minmax(0,1fr)_auto]">
  <span class="flex items-center gap-3">
    <ResultChip outcome={chip.letter} label={chip.label} />
    <span class="font-figures text-2xs uppercase tracking-eyebrow text-ink-faint">
      {game.roundShort}
    </span>
  </span>

  <span>
    <span class="font-display text-lg uppercase text-club break-words">
      {bye ? 'Bye' : `v ${game.opponent}`}
    </span>
    <span class="mt-1 block text-sm text-ink-muted">
      {summary}{order && ` · ${order}`}
    </span>
  </span>

  <span class="col-span-2 flex flex-wrap items-baseline gap-x-3 sm:col-span-1 sm:justify-end">
    {
      bye || abandoned || !game.ourScore ? (
        <span class="font-figures text-sm text-ink-faint">—</span>
      ) : (
        <span class="font-figures text-lg tabular-nums text-ink">
          {game.ourScore} <span class="text-ink-faint">v</span> {game.theirScore}
        </span>
      )
    }
  </span>

  {
    game.date && (
      <span class="col-span-2 text-sm text-ink-faint sm:col-span-3">
        <time datetime={isoDate(game.date)}>
          {formatDate(game.date, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })}
        </time>
        {game.ground && ` · ${game.ground}`}
      </span>
    )
  }
</div>
