---
import Logo from './Logo.astro';
import { formatDate, isoDate } from '../lib/format';
import { playedAtHome } from '../lib/site';
import type { PastGame } from '../lib/seasons';

interface Props {
  game: PastGame;
  /** How the club was named that season, e.g. "Dreamers SC - 4". */
  teamName: string;
}
const { game, teamName } = Astro.props;

const abandoned = game.outcome === 'ABANDONED';
const won = game.outcome === 'WON';
const lost = game.outcome === 'LOST';
const opponent = game.opponent ?? 'Opponent';

/* Home team is listed first, the way a scoreboard does it. Whether a game was
   home is decided by the ground, not by the fixture — the club's home ground
   is set in config/club.json. */
const atHome = playedAtHome(game.ground);

/* Opponents have no logo, so a monogram stands in: the initials of the first
   two words, ignoring the grade suffix PlayHQ appends. */
function monogram(name: string): string {
  return name
    .replace(/\s*-\s*\d+$/, '')
    .replace(/\bGrade\b.*$/i, '')
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('');
}

const us = {
  name: teamName,
  score: game.ourScore,
  winner: won,
  isClub: true,
};
const them = {
  name: opponent,
  score: game.theirScore,
  winner: lost,
  isClub: false,
};

const [left, right] = atHome ? [us, them] : [them, us];

const label = abandoned ? 'Abandoned' : 'Result';
const summary = abandoned
  ? 'Match abandoned — no result'
  : won
    ? `${teamName} won by ${game.margin}`
    : `${opponent} won by ${game.margin}`;
---

<article class="tile flex flex-col p-6 text-center" data-rule-in>
  <div class="flex items-center justify-center gap-3">
    <p class="rounded-chip bg-club px-4 py-1.5 font-display text-sm uppercase tracking-eyebrow text-paper">
      {label}
    </p>
    <p class="rounded-chip border border-rule-strong px-3 py-1 font-figures text-2xs uppercase tracking-eyebrow text-ink-muted">
      {atHome ? 'Home' : 'Away'}
    </p>
  </div>

  <p class="mt-5 font-display text-lg uppercase text-ink">
    {game.round}
    <span class="mx-2 text-rule-strong">|</span>
    {game.date && <time datetime={isoDate(game.date)}>{formatDate(game.date)}</time>}
  </p>
  {game.ground && <p class="mt-1 text-sm text-ink-muted">{game.ground}</p>}

  <!-- Home side on the left. The winning score is set in club navy and the
       other muted, so the result reads before the summary line does. -->
  <div class="mt-7 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
      <div class="flex flex-col items-center gap-3">
        {left.isClub ? (
          <span class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-club">
            <Logo class="h-14 w-14" width={56} alt="" />
          </span>
        ) : (
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-rule-strong bg-paper-sunk font-display text-lg uppercase text-ink-muted"
            aria-hidden="true"
          >
            {monogram(left.name)}
          </span>
        )}
        <span
          class:list={[
            'font-figures text-3xl tabular-nums leading-none',
            left.winner ? 'font-semibold text-club' : 'text-ink-muted',
          ]}
        >
          {left.score ?? '—'}
        </span>
        <span class="font-display text-sm uppercase leading-tight text-ink">{left.name}</span>
      </div>

      <div class="flex h-full flex-col items-center gap-2 self-stretch">
        <span class="w-px flex-1 bg-rule"></span>
        <span class="rounded-chip bg-accent px-2 py-1 font-display text-2xs uppercase tracking-eyebrow text-paper">
          vs
        </span>
        <span class="w-px flex-1 bg-rule"></span>
      </div>

      <div class="flex flex-col items-center gap-3">
        {right.isClub ? (
          <span class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-club">
            <Logo class="h-14 w-14" width={56} alt="" />
          </span>
        ) : (
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-rule-strong bg-paper-sunk font-display text-lg uppercase text-ink-muted"
            aria-hidden="true"
          >
            {monogram(right.name)}
          </span>
        )}
        <span
          class:list={[
            'font-figures text-3xl tabular-nums leading-none',
            right.winner ? 'font-semibold text-club' : 'text-ink-muted',
          ]}
        >
          {right.score ?? '—'}
        </span>
        <span class="font-display text-sm uppercase leading-tight text-ink">{right.name}</span>
      </div>
  </div>

  <p class="mt-7 border-t border-rule pt-5 text-ink-muted">{summary}</p>
</article>
