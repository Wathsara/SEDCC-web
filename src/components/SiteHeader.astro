---
import Logo from './Logo.astro';
import { club, showNews, url } from '../lib/site';

const path = Astro.url.pathname;

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
  children?: Array<{ label: string; href: string }>;
}

const nav: NavItem[] = [
  {
    // About and the strategic plan belong together, and grouping them keeps the
    // top level from growing to ten.
    label: 'About',
    href: url('about'),
    children: [
      { label: 'Our story', href: url('about') },
      { label: 'Strategic plan', href: url('plan') },
    ],
  },
  ...(showNews ? [{ label: 'News', href: url('news') }] : []),
  { label: 'Teams', href: url('teams') },
  { label: 'Stats', href: url('stats') },
  { label: 'Seasons', href: url('seasons') },
  { label: 'Honour board', href: url('honour-board') },
  { label: 'Gallery', href: url('gallery') },
  { label: 'Sponsors', href: url('sponsors') },
  // The store is Tradexco's, not ours — link straight out rather than
  // bouncing people through a page that only says so.
  { label: 'Store', href: club.store.url, external: true },
  { label: 'Contact', href: url('contact') },
];

const isCurrent = (href: string) => path === href || (href !== url('/') && path.startsWith(href));
const current = (item: { href: string; external?: boolean }) =>
  !item.external && isCurrent(item.href);
/** A parent is marked current when any of its children is. */
const branchCurrent = (item: NavItem) =>
  current(item) || (item.children ?? []).some((c) => isCurrent(c.href));

/* Ten items need well over 1000px in a row, so the horizontal nav starts at xl
   and everything below gets the disclosure menu. */
---

<header class="relative z-40 border-b border-white/10 bg-club text-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5">
    <a href={url('/')} class="group flex items-center gap-2.5">
      <Logo class="h-9 w-9 shrink-0 transition-transform group-hover:scale-105" width={36} />
      <span
        class="font-display text-xl uppercase tracking-display text-paper transition-colors group-hover:text-accent-tint"
        >{club.shortName}</span
      >
    </a>

    <!-- Desktop -->
    <nav aria-label="Main" class="hidden items-center gap-x-5 xl:flex">
      {
        nav.map((item) =>
          item.children ? (
            <details class="nav-menu relative">
              <summary
                class:list={[
                  'flex items-center gap-1 py-1 font-display text-xs uppercase tracking-eyebrow transition-colors',
                  branchCurrent(item) ? 'font-semibold text-paper' : 'text-accent-tint hover:text-paper',
                ]}
              >
                {item.label}
                <svg
                  class="nav-menu__chevron h-3 w-3 transition-transform"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <div class="nav-menu__panel">
                {item.children.map((c) => (
                  <a
                    href={c.href}
                    aria-current={isCurrent(c.href) ? 'page' : undefined}
                    class="nav-menu__link"
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer external' : undefined}
              aria-current={current(item) ? 'page' : undefined}
              class:list={[
                'stitch-link py-1 font-display text-xs uppercase tracking-eyebrow transition-colors',
                current(item) ? 'font-semibold text-paper' : 'text-accent-tint hover:text-paper',
              ]}
            >
              {item.label}
              {item.external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          ),
        )
      }
    </nav>

    <!-- Mobile: a disclosure, so it works with JavaScript off -->
    <details class="nav-disclosure xl:hidden">
      <summary
        class="-mr-2 flex h-11 w-11 items-center justify-center text-accent-tint transition-colors hover:text-paper"
        aria-label="Menu"
      >
        <svg
          class="nav-icon--open h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg
          class="nav-icon--close h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </summary>

      <nav
        aria-label="Main"
        class="absolute inset-x-0 top-full z-50 border-b border-white/10 bg-club shadow-lift"
      >
        <div class="mx-auto max-w-6xl px-4 pb-4">
          {
            /* Children are flattened and indented rather than nested in another
               disclosure — one tap to anything, no menu inside a menu. */
            nav.flatMap((item) =>
              item.children
                ? [
                    /* A group label, so the indented children are not orphans
                       and "About" is still findable by name. */
                    <p class="nav-panel__group">{item.label}</p>,
                    ...item.children.map((c) => (
                      <a
                        href={c.href}
                        aria-current={isCurrent(c.href) ? 'page' : undefined}
                        class="nav-panel__link nav-panel__link--child"
                      >
                        {c.label}
                      </a>
                    )),
                  ]
                : [
                    <a
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener noreferrer external' : undefined}
                      aria-current={current(item) ? 'page' : undefined}
                      class="nav-panel__link"
                    >
                      {item.label}
                      {item.external && (
                        <span aria-hidden="true" class="ml-1 text-sm">
                          &#8599;
                        </span>
                      )}
                      {item.external && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>,
                  ],
            )
          }
        </div>
      </nav>
    </details>
  </div>
  <div class="seam seam--onclub"></div>
</header>
