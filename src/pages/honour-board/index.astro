---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import HonoursBoard from '../../components/HonoursBoard.astro';
import CricketIcon from '../../components/CricketIcon.astro';
import RecordCard from '../../components/RecordCard.astro';
import { allTime, filled, centuries, fiveWicketHauls, seasonLeaders, url } from '../../lib/site';

/*
  Two boards, the way Lord's does it: hundreds on one, five-wicket hauls on the
  other, newest at the top. Everything below them is the club's other history
  and only renders once someone fills it in — a records table full of blanks
  reads as a broken page.
*/
type Record_ = {
  label: string; value: string | null; holder?: string | null;
  detail?: string | null; season?: string | null; balls?: number | null;
};

const recordGroups = (
  [
    ['Batting', allTime.records.batting],
    ['Bowling', allTime.records.bowling],
    ['Team', allTime.records.team],
  ] as const
)
  .map(([label, rows]) => ({
    label,
    icon: (label === 'Bowling' ? 'ball' : label === 'Team' ? 'stumps' : 'bat') as
      | 'bat' | 'ball' | 'stumps',
    rows: (rows as Record_[]).filter((r) => filled(r.value)),
  }))
  .filter((g) => g.rows.length > 0);

type Premiership = { grade?: string; competition?: string; season?: string };
type LifeMember = { name?: string; year?: string | number };
const premierships = (allTime.premierships ?? []) as Premiership[];
const lifeMembers = (allTime.lifeMembers ?? []) as LifeMember[];
---

<Base
  title="Honour board"
  description="Centuries and five-wicket hauls for Dreamers Cricket Club, newest first."
>
  <PageHeader
    eyebrow="Club Heritage & Honours"
    title="Pavilion Honour Board"
    intro="Centuries and Five-Wicket Hauls for Dreamers Cricket Club, crafted in the tradition of the Lord's dressing room honours boards."
  />

  <div class="band-dark relative overflow-hidden bg-club">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20 relative z-10">
      <div class="grid gap-10 lg:grid-cols-2">
        <HonoursBoard
          title="Centuries"
          rows={centuries}
          field="score"
          emptyNote="No centuries recorded yet"
        />
        <HonoursBoard
          title="Five Wickets"
          rows={fiveWicketHauls}
          field="figures"
          emptyNote="No five-wicket hauls recorded yet"
        />
      </div>

      <p class="mx-auto mt-12 flex max-w-prose items-center justify-center gap-3 text-center text-sm text-[#dfb74c]">
        <CricketIcon name="trophy" class="h-5 w-5 shrink-0 text-[#dfb74c]" />
        If you have a historic milestone performance we have missed,{' '}
        <a href={url('contact')} class="underline underline-offset-4 text-paper hover:text-[#dfb74c] transition-colors">notify the committee</a>.
      </p>
    </div>
    <div class="seam seam--onclub"></div>
  </div>

  {
    recordGroups.length > 0 && (
      <section class="border-b border-rule bg-paper-sunk">
        <div class="mx-auto max-w-6xl px-4 py-16">
          <SectionHead title="Club records" />
          {recordGroups.map((group) => (
            <div class="mb-12 last:mb-0">
              <p class="eyebrow mb-4">{group.label}</p>
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {group.rows.map((r) => (
                  <RecordCard
                    label={r.label}
                    value={r.value!}
                    balls={r.balls}
                    holder={r.holder}
                    detail={r.detail}
                    season={r.season}
                    icon={group.icon}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    seasonLeaders.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
        <SectionHead title="Season leaders" />
        <div class="grid gap-6 sm:grid-cols-2">
          {seasonLeaders.map((s) => (
            <div class="tile p-5 sm:p-6 border-t-2 border-t-club" data-rule-in>
              <div class="flex items-center justify-between border-b border-rule pb-2.5">
                <span class="font-display text-lg uppercase text-club">{s.label} Campaign</span>
                <span class="eyebrow bg-club/5 px-2 py-0.5 rounded text-club font-semibold">{s.competitionShort} · {s.grade}</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-4">
                {s.mostRuns && (
                  <div>
                    <div class="flex items-center gap-1.5 text-accent">
                      <CricketIcon name="bat" class="h-3.5 w-3.5" />
                      <span class="eyebrow text-2xs">Top Batter</span>
                    </div>
                    <p class="mt-1 font-display text-sm uppercase text-club truncate">{s.mostRuns.name}</p>
                    <p class="font-figures text-xl font-bold tabular-nums text-ink">
                      {s.mostRuns.runs}{' '}
                      <span class="text-xs font-normal text-ink-faint">@ {s.mostRuns.average}</span>
                    </p>
                  </div>
                )}
                {s.mostWickets && (
                  <div>
                    <div class="flex items-center gap-1.5 text-accent">
                      <CricketIcon name="ball" class="h-3.5 w-3.5" />
                      <span class="eyebrow text-2xs">Top Bowler</span>
                    </div>
                    <p class="mt-1 font-display text-sm uppercase text-club truncate">{s.mostWickets.name}</p>
                    <p class="font-figures text-xl font-bold tabular-nums text-ink">
                      {s.mostWickets.wickets}{' '}
                      <span class="text-xs font-normal text-ink-faint">@ {s.mostWickets.average}</span>
                    </p>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <div class="mx-auto max-w-6xl px-4 py-16 space-y-14">
    <!-- Grand Finals & Major Accolades -->
    <section class="tile p-7 sm:p-8 bg-paper border-t-2 border-t-[#b4b5ba]" data-rule-in>
      <div class="flex items-center justify-between gap-3 border-b border-rule pb-4">
        <div>
          <p class="eyebrow text-accent">Club Accolades</p>
          <h3 class="font-display text-2xl uppercase tracking-tight text-club">Grand Finals & Major Honours</h3>
        </div>
        <div class="flex h-9 w-9 items-center justify-center rounded bg-club/5 text-club">
          <CricketIcon name="trophy" class="h-5 w-5 text-accent" />
        </div>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div class="border border-[#b4b5ba]/60 bg-[#b4b5ba]/5 p-5 relative overflow-hidden">
          <div class="flex items-center justify-between gap-2">
            <span class="font-figures text-xs uppercase tracking-eyebrow text-club font-bold">2025/26 Campaign</span>
            <span class="rounded border border-[#b4b5ba] bg-[#cfd3db] px-2.5 py-0.5 text-2xs font-display uppercase tracking-eyebrow text-club font-bold shadow-xs">
              🥈 Runners-up
            </span>
          </div>
          <p class="mt-3 font-display text-xl uppercase tracking-wide text-club">VSCA Grade 4 Grand Finalists</p>
          <p class="mt-1 text-xs text-ink-muted">Victorian Sunday Cricket Association · Competed as Dreamers SC</p>
          <a href={url('seasons/2025-26')} class="stitch-link mt-4 inline-block font-display text-xs uppercase tracking-eyebrow text-club hover:text-accent transition-colors">
            View 2025/26 Campaign Archive →
          </a>
        </div>
      </div>
    </section>

    {
      premierships.length > 0 && (
        <section>
          <SectionHead title="Premierships" />
          <ul>
            {premierships.map((p) => (
              <li class="card-line" data-rule-in>
                <span class="card-line__name">{p.grade ?? p.competition}</span>
                <span class="card-line__figures">{p.season}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      lifeMembers.length > 0 && (
        <section>
          <SectionHead title="Life members" />
          <ul>
            {lifeMembers.map((m) => (
              <li class="card-line" data-rule-in>
                <span class="card-line__name">{m.name}</span>
                <span class="card-line__figures">{m.year}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script>
  import '../../scripts/motion.ts';
</script>
