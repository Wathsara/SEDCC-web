# Dependencies and build output
node_modules/
dist/
.astro/
*.tsbuildinfo

# Secrets — PLAYHQ_API_KEY lives here locally and in GitHub Actions secrets.
# It must never reach the repository or the client bundle.
.env
.env.*
!.env.example

# Local tooling and notes. The repository is public and only needs what is
# required to build and serve the site.
.devcontainer/
.claude/
.agents/
CLAUDE.md
README.md
skills-lock.json
src/assets/README.md

# Scratch files
image.png
image copy.png
match-summary.png
match-summary*.png
*.local

# OS and editor
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# The field map weekend-summary.mjs writes beside each card, kept only so a
# card that looks wrong can be traced back to the data that made it.
.summary-*.json

# Output of a backfill/test sync against an old season.
.playhq-test/

# Batch-rendered cards from a past season.
season-cards/

# Player photos for the MVP posters. Images of real people — keep the originals
# somewhere the club controls, not in a public repo. The README stays.
MVP/players/*
!MVP/players/README.md

# MVP poster output and the field map that produced it.
.mvp-*.json
mvp-*.png
