---
import CricketIcon from './CricketIcon.astro';
import PlayerPortrait from './PlayerPortrait.astro';
import { formatDate } from '../lib/format';
import { teamBySlug, portraitKey } from '../lib/site';
import type { Performance } from '../lib/playhq-types';

interface Props {
  batter: Performance | null;
  bowler: Performance | null;
}
const { batter, bowler } = Astro.props;

/*
  The headline and what qualifies it are separate, so the big figure never has
  to share a line with its bracket — "2/34 (6 ov)" at display size wrapped on a
  phone and broke across the closing bracket.
*/
const batting = (p: Performance) =>
  p.batting
    ? { head: `${p.batting.runs}${p.batting.notOut ? '*' : ''}`, sub: `${p.batting.balls}b` }
    : { head: '', sub: '' };

const bowling = (p: Performance) =>
  p.bowling
    ? { head: `${p.bowling.wickets}/${p.bowling.runs}`, sub: `${p.bowling.overs} ov` }
    : { head: '', sub: '' };

const entries = [
  batter && { label: 'Top batter', icon: 'bat' as const, p: batter, figures: batting(batter) },
  bowler && { label: 'Top bowler', icon: 'ball' as const, p: bowler, figures: bowling(bowler) },
].filter(Boolean) as Array<{
  label: string;
  icon: 'bat' | 'ball';
  p: Performance;
  figures: { head: string; sub: string };
}>;
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    entries.map(({ label, icon, p, figures }) => (
      <div class="tile p-5 sm:p-7 border-t-2 border-t-club transition-all hover:shadow-lift" data-rule-in>
        <div class="flex items-center justify-between gap-3">
          <p class="eyebrow text-accent">{label}</p>
          <div class="flex h-7 w-7 items-center justify-center rounded bg-club/5 text-club">
            <CricketIcon name={icon} class="h-4 w-4 text-accent" />
          </div>
        </div>
        {/*
          The face first, then the name. A week's best performance is a person,
          and the card was the one place on the page that named one without
          showing them.
        */}
        <div class="mt-4 flex items-center gap-3 sm:gap-4">
          <span class="h-14 w-14 shrink-0 overflow-hidden rounded-full border border-rule bg-paper-sunk sm:h-16 sm:w-16">
            <PlayerPortrait
              id={portraitKey(p.displayName)}
              name={p.displayName}
              class="h-full w-full object-cover object-top"
            />
          </span>
          <div class="min-w-0">
            <p class="font-display text-xl uppercase tracking-wide text-club sm:text-2xl">
              {p.displayName}
            </p>
            <p class="mt-0.5 flex items-baseline gap-2 whitespace-nowrap">
              <span class="font-figures text-4xl font-bold tabular-nums text-ink">
                {figures.head}
              </span>
              <span class="font-figures text-sm tabular-nums text-ink-muted">{figures.sub}</span>
            </p>
          </div>
        </div>
        <p class="mt-3 text-sm text-ink-muted border-t border-rule pt-3">
          {teamBySlug(p.teamSlug)?.shortName ?? p.teamSlug} · {p.round} v {p.opponent} ·{' '}
          {formatDate(p.date, { day: 'numeric', month: 'short' })}
        </p>
      </div>
    ))
  }
</div>
