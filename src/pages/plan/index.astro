---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import CricketIcon from '../../components/CricketIcon.astro';
import { club, vision, mission, clubValues, url } from '../../lib/site';
import {
  strategyTitle, strategyPeriod, strategySummary, strategySections,
} from '../../lib/strategy';
---

<Base
  title={strategyTitle}
  description={strategySummary ?? `The strategic plan for ${club.name}.`}
>
  <PageHeader
    eyebrow={strategyPeriod ? `Strategic development plan · ${strategyPeriod}` : 'Strategic plan'}
    title={strategyTitle}
    intro={strategySummary}
  />

  <!-- Vision and mission set the frame for everything below. -->
  {
    (vision || mission) && (
      <div class="band-dark">
        <div class="mx-auto grid max-w-4xl gap-10 px-4 py-14 sm:grid-cols-2">
          {vision && (
            <div>
              <p class="eyebrow text-accent-tint">Our vision</p>
              <p class="mt-3 leading-relaxed">{vision}</p>
            </div>
          )}
          {mission && (
            <div>
              <p class="eyebrow text-accent-tint">Our mission</p>
              <p class="mt-3 leading-relaxed">{mission}</p>
            </div>
          )}
        </div>
        <div class="seam seam--onclub" />
      </div>
    )
  }

  <div class="mx-auto max-w-5xl px-4 py-16">
    {
      clubValues.length > 0 && (
        <section class="mb-16">
          <SectionHead title="Our values" />
          <ul class="flex flex-wrap gap-3">
            {clubValues.map((v) => (
              <li class="flex items-center gap-2 border border-rule bg-paper-sunk px-4 py-2">
                <CricketIcon name={v.icon} class="h-4 w-4 shrink-0 text-accent" />
                <span class="font-display text-sm uppercase tracking-eyebrow text-club">
                  {v.name}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      strategySections.map((s) => (
        <section class="mb-14 last:mb-0">
          <SectionHead title={s.title} note={s.note ?? undefined} />
          <dl class="grid gap-6 sm:grid-cols-2">
            {s.items.map((o) => (
              <div class="tile p-6" data-rule-in>
                <div class="flex items-center gap-3">
                  <CricketIcon name={s.icon} class="h-4 w-4 shrink-0 text-accent" />
                  <dt class="font-display text-base uppercase tracking-eyebrow text-club">
                    {o.name}
                  </dt>
                </div>
                <dd class="mt-3 text-sm leading-relaxed text-ink-muted">{o.detail}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <p class="mt-14 border-t border-rule pt-6 text-sm text-ink-muted">
      Interested in playing, coaching, volunteering or sponsoring as the club grows?{' '}
      <a href={url('contact')} class="stitch-link text-club">Get in touch</a>.
    </p>
  </div>
</Base>

<script>
  import '../../scripts/motion.ts';
</script>
